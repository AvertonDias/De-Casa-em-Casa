
rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        // --- FUNÇÕES AUXILIARES ---
        
        function isAuth() { 
            return request.auth != null; 
        }
        
        function userExists() {
            return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
        }

        function getUserData() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        }
        
        function isOfCongregation(congId) {
            return userExists() && getUserData().congregationId == congId;
        }

        function isAdmin() {
            return userExists() && getUserData().role == 'Administrador';
        }

        function isManager() {
            return userExists() && getUserData().role in ['Administrador', 'Dirigente', 'Servo de Territórios', 'Ajudante de Servo de Territórios'];
        }

        function isActive() {
            return userExists() && getUserData().status == 'ativo';
        }

        // --- REGRAS POR COLEÇÃO ---

        match /congregations/{congId} {
            allow read: if true; 
            allow create, update: if isAuth();
            allow delete: if isAuth();

            // Histórico de Auditoria
            match /auditLogs/{logId} {
                allow read, write: if isAuth();
            }

            match /territories/{terrId} {
                allow read: if true;
                allow create, update, delete: if isAuth();

                match /quadras/{quadraId} {
                    allow read, write: if true;
                    
                    match /casas/{casaId} { 
                        allow read, write: if true;
                    }
                }
                match /activityHistory/{activityId} { 
                    allow read, write: if true;
                }
            }
        }

        match /users/{userId} {
            allow read, write: if isAuth();
            allow get: if true;

            match /notifications/{notifId} {
                allow read, write: if isAuth();
            }
        }

        match /resetTokens/{tokenId} {
            allow read, write: if true;
        }

        match /loginAttempts/{email} {
            allow read, write: if true;
        }

        match /feedbacks/{feedbackId} { 
            allow read, write: if isAuth(); 
        }
    }
}

